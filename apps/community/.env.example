# Local fixture preview only; ignored .env.local or secure environment settings hold values.
COMMUNITY_PREVIEW=true
# For a private Vercel Preview with database-backed test records:
# COMMUNITY_PREVIEW=database
# COMMUNITY_ENVIRONMENT=development
# COMMUNITY_DEV_SUPABASE_PROJECT_REF=<confirmed-development-project-ref>
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Dedicated read-only previewer account, server-only. Never use reviewer/service-role credentials.
COMMUNITY_PREVIEW_EMAIL=
COMMUNITY_PREVIEW_PASSWORD=
